{
	admin off
	auto_https off
	persist_config off
	# trust X-Forwarded-* headers from a reverse proxy on a private network
	servers {
		trusted_proxies static private_ranges
	}
	log {
		level WARN
	}
}

:8080 {
	encode zstd gzip

	# Go backend: Connect/gRPC API, auth, avatars, MCP + OAuth metadata
	@backend path /api/* /.well-known/*
	handle @backend {
		reverse_proxy 127.0.0.1:9000
	}

	# SvelteKit single-page app
	handle {
		root * /srv
		header /_app/immutable/* Cache-Control "public, max-age=31536000, immutable"
		try_files {path} /index.html
		file_server
	}
}
